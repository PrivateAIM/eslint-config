{
    "name": "@privateaim/eslint-config",
    "version": "0.0.0",
    "type": "module",
    "description": "Shared ESLint flat config for PrivateAIM projects",
    "author": {
        "name": "PrivateAIM",
        "url": "https://privateaim.github.io"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/PrivateAIM/eslint-config.git"
    },
    "bugs": {
        "url": "https://github.com/PrivateAIM/eslint-config/issues"
    },
    "homepage": "https://github.com/PrivateAIM/eslint-config#readme",
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24.3.0"
    },
    "scripts": {
        "build": "tsc --noEmit -p tsconfig.build.json && tsdown",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "keywords": [
        "eslint",
        "config",
        "eslintconfig",
        "flat-config",
        "javascript",
        "typescript",
        "vue",
        "privateaim"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@tada5hi/eslint-config": "^3.2.0"
    },
    "peerDependencies": {
        "eslint": ">=10.4.0",
        "eslint-plugin-vue": ">=10.0.0",
        "typescript-eslint": ">=8.57.0"
    },
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.2",
        "@tada5hi/eslint-config": "^3.2.0",
        "@tada5hi/tsconfig": "^0.7.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "husky": "^9.1.7",
        "tsdown": "^0.23.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    }
}
